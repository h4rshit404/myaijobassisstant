# Copy to .env and fill in. See README.md "Environment variables" for details.

# Postgres connection string (matches docker-compose.yml by default)
DATABASE_URL="postgresql://myjobassistant:myjobassistant@localhost:5433/myjobassistant"

# NextAuth session signing secret + AES-256-GCM key for encrypting stored API keys/tokens.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# Google OAuth (Gmail sign-in + send scope) — console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional app-level fallback keys for job-source APIs (users can also set their own in Settings)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
SERPAPI_KEY=
JOOBLE_API_KEY=
HUNTER_API_KEY=

# Optional: OpenRouter key used as a free Grok fallback when a user's own OpenAI key is
# missing/invalid or the OpenAI call fails, before giving up and using the static template.
# Get a key at https://openrouter.ai/keys — the model used (x-ai/grok-4-fast:free) costs
# nothing on OpenRouter's free tier, but is rate-limited and can be rotated/retired by
# OpenRouter without notice.
OPENROUTER_API_KEY=

# Optional: Groq key used as a further free fallback (after OpenRouter, before the static
# template). Get a key at https://console.groq.com/keys — the model used
# (llama-3.3-70b-versatile) costs nothing on Groq's free tier, but is rate-limited and can be
# rotated/retired by Groq without notice.
GROQ_API_KEY=
